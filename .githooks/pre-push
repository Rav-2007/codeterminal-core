#!/usr/bin/env bash
#
# pre-push — run the same gate CI runs, before the push rather than after.
#
# Installed by `make hooks` (which sets core.hooksPath to .githooks/). Tracked in
# the repo so it is reviewable and so everyone gets the same one; git does not
# sync .git/hooks between clones, which is why this lives here instead.
#
# WHY THIS EXISTS
#
# CI runs on every push and PR to main but does not BLOCK a merge. This hook is
# the compensating control: it moves the gate to the one place that still has a
# veto, which is the moment before code leaves the machine.
#
# WHY IT WAS UNAVOIDABLE, AND WHAT CHANGED 2026-09-20. Branch protection used to
# be impossible here: the repo was private on a free plan, and
# `GET /repos/:owner/:repo/branches/main/protection` answered 403 Upgrade
# (checked 2026-07-30). The repository is now PUBLIC, and the same endpoint
# answers 404 Not Found (checked 2026-09-20) -- which is the "no rule
# configured" answer, not the "not allowed" one. So the remedy this comment used
# to name as out of reach is now one owner action away.
#
# IT IS NOT CONFIGURED, and this hook is therefore still the only gate. Nothing
# below assumes otherwise. Configuring required status checks on main is an
# owner decision, and until it is taken the sentence above stays true.
#
# RESIDUAL, stated rather than hidden: `git push --no-verify` skips this
# entirely, and nothing here can prevent that. It is a guard against forgetting,
# not against deciding.
#
# WHAT IT RUNS
#
# build, gofmt, vet, and `go test -race` across all six modules -- the four that
# catch a broken push. Deliberately NOT the coverage ratchet, the linters, or
# the fuzz targets: those add roughly a minute for checks whose failures are
# advisory rather than "this push is broken", and a hook slow enough to be
# annoying is a hook people learn to bypass. `make check` runs everything.
#
# Plus three sub-second, offline checks that have NO OTHER ENFORCEMENT POINT:
# doc links, the cross-register claim check, and action pinning. Each is here
# because CI cannot or does not cover it -- see the comment above each one.

set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)"

# git runs hooks with a STRIPPED environment -- notably not the PATH from an
# interactive shell's profile. A Go toolchain installed anywhere other than a
# system directory is therefore invisible here, and the hook fails every push
# with "go: command not found" while the same commands pass in a terminal.
#
# That is not a cosmetic problem. A hook that always fails for a reason
# unrelated to the code is a hook everyone learns to --no-verify, which quietly
# removes the only gate this repo actually has configured today.
# Found the first time this hook ran on a real push.
if ! command -v go >/dev/null 2>&1; then
  for candidate in "$HOME/.local/go/bin" /usr/local/go/bin "$HOME/go/bin" /usr/lib/go/bin; do
    if [ -x "$candidate/go" ]; then
      PATH="$PATH:$candidate"
      export PATH
      break
    fi
  done
fi

if ! command -v go >/dev/null 2>&1; then
  echo "pre-push: no 'go' on PATH, and none found in the usual install locations." >&2
  echo "pre-push: git hooks do not inherit your shell profile -- either install Go" >&2
  echo "pre-push: somewhere on the system PATH, or add its bin directory here." >&2
  exit 1
fi

# There is no root Go module -- only go.work -- so `./...` from the repo root
# fails outright. Every module is named explicitly.
MODULES=(daemon editapply proxy helper protocol clients/tui)

status=0
for module in "${MODULES[@]}"; do
  dir="$repo_root/$module"

  if ! out="$(cd "$dir" && go build ./... 2>&1)"; then
    echo "pre-push: BUILD failed in $module" >&2
    echo "$out" >&2
    status=1
    continue
  fi

  # gofmt -l prints offending files and exits 0, so the output is the signal.
  unformatted="$(cd "$dir" && gofmt -l . 2>&1)"
  if [ -n "$unformatted" ]; then
    echo "pre-push: gofmt found unformatted files in $module:" >&2
    echo "$unformatted" >&2
    status=1
  fi

  if ! out="$(cd "$dir" && go vet ./... 2>&1)"; then
    echo "pre-push: VET failed in $module" >&2
    echo "$out" >&2
    status=1
    continue
  fi

  # THE BUILD-TAGGED FILES, which an untagged vet does not compile.
  #
  # Same class of gap as the action-pinning one this hook was extended for
  # yesterday, and found the same way -- by asking where a check actually runs
  # rather than where it is written down. `go vet -tags eval` and
  # `-tags warnscan` were added to `make check` and called done. CI runs neither:
  # build.yml's Vet step is a bare `go vet ./...`, and so was this hook. So the
  # only thing compiling daemon's eval and warnscan suites was somebody choosing
  # to run make check.
  #
  # That is exactly the state the Makefile comment beside those lines was
  # written to end -- "a gate that only fires nightly is a gate that reports rot
  # rather than preventing it" -- and warnscan was worse: it moved from being
  # compiled by NOTHING to being compiled by make check, which is the same
  # enforcement value. Both eval files had already broken once on a signature
  # change with nothing noticing until the next manual run.
  #
  # daemon only, because daemon is the only module with tagged files. Costs
  # about a second; these compile the test files without running them.
  if [ "$module" = "daemon" ]; then
    for tag in eval warnscan; do
      if ! out="$(cd "$dir" && go vet -tags "$tag" ./... 2>&1)"; then
        echo "pre-push: VET (-tags $tag) failed in $module" >&2
        echo "$out" >&2
        status=1
      fi
    done
  fi

  # -race, not a bare `go test`: this repo's concurrency work (the Gate 6
  # apply/undo locking in particular) is only defended by the race detector.
  if ! out="$(cd "$dir" && go test -race ./... 2>&1)"; then
    echo "pre-push: TESTS failed in $module" >&2
    echo "$out" >&2
    status=1
    continue
  fi

  echo "pre-push: ok $module"
done

# Markdown links. Cheap (~1s, no toolchain), and its failure means what the
# other checks here mean: something is broken in what is about to leave.
#
# THIS HOOK IS THE ONLY GATE THAT COVERS IT. build.yml carries
# `paths-ignore: ["**.md"]`, so a documentation-only push does not start CI at
# all -- and a documentation-only push is precisely how a link breaks, because
# renaming or deleting a doc touches nothing else. Removing this from here does
# not move the check elsewhere; it removes it.
if [ -x "$repo_root/scripts/docs-links.sh" ]; then
  if ! out="$("$repo_root/scripts/docs-links.sh" 2>&1)"; then
    echo "pre-push: BROKEN DOC LINKS" >&2
    echo "$out" >&2
    status=1
  else
    echo "pre-push: ok docs ($(printf '%s' "$out" | tail -1))"
  fi
fi

# Index completeness rides with the link checker, for the same reason and
# against the opposite failure: docs-links asks whether the index's members are
# real, this asks whether the directory's members are indexed. A documentation
# push is exactly when a new file appears with nothing pointing at it.
if [ -x "$repo_root/scripts/docs-index.sh" ]; then
  if ! out="$("$repo_root/scripts/docs-index.sh" 2>&1)"; then
    echo "pre-push: DOCUMENTS MISSING FROM THE INDEX" >&2
    echo "$out" >&2
    status=1
  else
    echo "pre-push: ok index ($(printf '%s' "$out" | head -1))"
  fi
fi

# The cross-register claim check, here for exactly the reason stated above and
# with more force than the link checker needs it.
#
# A documentation-only push does not start CI, and a documentation-only push is
# the ONLY way BACKLOG.md and docs/OPEN_ITEMS.md drift apart -- editing a status
# cell touches no code. Wiring this into `make docs` alone would have left it
# inert for its own use case: the drift it exists to catch would sail past the
# hook, never reach CI, and be found the next time somebody read both files

# scripts/docs-coderefs.sh rides with docs-links for the same reason: it is pure
# grep over markdown, it costs milliseconds, and the thing it catches -- a
# register row pointing at code that has moved -- is invisible to every other
# gate here.
if [ -x "$repo_root/scripts/docs-coderefs.sh" ]; then
  if ! out="$("$repo_root/scripts/docs-coderefs.sh" 2>&1)"; then
    echo "pre-push: BLOCKED -- a code reference in an enforced document does not resolve" >&2
    printf '%s\n' "$out" >&2
    exit 1
  fi
  echo "pre-push: ok coderefs ($(printf '%s' "$out" | tail -1))"
fi

# carefully, which last time took nineteen days.
if [ -x "$repo_root/scripts/docs-claims.sh" ]; then
  if ! out="$("$repo_root/scripts/docs-claims.sh" --self-test 2>&1)" \
     || ! out="$("$repo_root/scripts/docs-claims.sh" 2>&1)"; then
    echo "pre-push: DOC REGISTERS DISAGREE" >&2
    echo "$out" >&2
    status=1
  else
    echo "pre-push: ok claims ($(printf '%s' "$out" | tail -1))"
  fi
fi

# Supply-chain pinning, here because THIS HOOK IS THE ONLY THING THAT RUNS IT.
#
# scripts/actions-pinned.sh went into `make check` on 2026-08-31 and that is not
# an enforcement point: CI does not run `make check` -- build.yml runs individual
# steps per module -- so the check fired only for someone who chose to run it.
# A gate whose entire coverage is "somebody remembered" is the shape of every
# stale claim this repo has had to correct.
#
# It belongs in the same tier as the two doc checks above rather than with the
# linters the header excludes: sub-second, offline, no toolchain. Its sibling
# scripts/govulncheck.sh deliberately stays OUT -- ~17s and it needs the
# vulnerability database, so it would make this hook slow and fail on a train.
# build.yml already runs govulncheck per module, so that one has a real CI
# enforcement point and this one does not.
if [ -x "$repo_root/scripts/actions-pinned.sh" ]; then
  if ! out="$("$repo_root/scripts/actions-pinned.sh" 2>&1)"; then
    echo "pre-push: UNPINNED GITHUB ACTION" >&2
    echo "$out" >&2
    status=1
  else
    echo "pre-push: ok actions ($(printf '%s' "$out" | tail -1))"
  fi
fi

# The Go version floor, here for the same reason the three checks above are: it
# is sub-second, offline, needs no toolchain, and has no other enforcement point.
#
# It exists because `toolchain go1.25.13` is a SELECTION HINT, not a floor.
# Measured 2026-09-01: `daemon` carries that line and still built on go1.25.12
# under GOTOOLCHAIN=local, with four reachable stdlib flaws; `proxy`, the
# internet-facing one, had five. The hard floor is the `go` directive, and it now
# has to agree across go.work and all six go.mod -- seven files, bumped by hand,
# which is precisely the shape that drifts.
#
# Its sibling scripts/govulncheck.sh stays OUT, unchanged: ~17s and it needs the
# vulnerability database. This one is string comparison and runs on a train.
if [ -x "$repo_root/scripts/go-toolchain-pinned.sh" ]; then
  if ! out="$("$repo_root/scripts/go-toolchain-pinned.sh" 2>&1)"; then
    echo "pre-push: GO TOOLCHAIN PINS DISAGREE" >&2
    echo "$out" >&2
    status=1
  else
    echo "pre-push: ok toolchain ($(printf '%s' "$out" | tail -1))"
  fi
fi

if [ $status -ne 0 ]; then
  echo "" >&2
  echo "pre-push: REFUSING THE PUSH. Fix the above, or use --no-verify if you" >&2
  echo "genuinely mean to push a red tree (and say so in the PR)." >&2
fi

exit $status
