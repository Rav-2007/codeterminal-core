{
  "name": "codeterminal-vscode",
  "displayName": "CodeTerminal",
  "description": "Chat with CodeTerminal's local daemon from inside VS Code.",
  "version": "0.0.1",
  "private": true,
  "publisher": "codeterminal",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:codeterminal.openChat",
    "onCommand:codeterminal.restartDaemon"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codeterminal.openChat",
        "title": "CodeTerminal: Open Chat"
      },
      {
        "command": "codeterminal.restartDaemon",
        "title": "CodeTerminal: Restart Daemon"
      }
    ]
  },
  "scripts": {
    "build:daemon": "cd ../../ && go build -o clients/vscode/daemon/codeterminal-daemon ./daemon",
    "compile": "npm run build:daemon && tsc -p ./",
    "watch": "tsc -w -p ./",
    "pretest": "tsc -p ./",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.0.0",
    "glob": "^10.4.1",
    "mocha": "^10.4.0",
    "typescript": "^5.4.0"
  }
}
